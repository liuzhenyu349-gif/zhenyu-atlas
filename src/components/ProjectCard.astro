---
import type { Project } from "../types/config";
import { withBase } from "../utils/url";

type Props = Project & { index?: number };
const { title, description, image, imageAlt, previewNote, year, field, url, status, index = 0 } = Astro.props;
---

<article class:list={["project", { reverse: index % 2 === 1 }]}>
  <div class="project-image">
    {image && url ? (
      <a class="project-image-link" href={withBase(url)} aria-label={`打开 ${title} 项目页面`}>
        <img src={withBase(image)} alt={imageAlt ?? `${title} 的${previewNote ? "早期" : ""}项目页面预览图`} loading="lazy" width="1440" height="900" />
        <span class="preview-hint">{previewNote ?? "Open project ↗"}</span>
      </a>
    ) : image ? <img src={withBase(image)} alt={`${title} 的项目页面预览图`} loading="lazy" width="1440" height="900" /> : <div class="placeholder" aria-hidden="true">Future field note</div>}
  </div>
  <div class="project-copy">
    <p class="eyebrow">{status ?? "Project"}</p>
    <h2>{title}</h2>
    <p class="description">{description}</p>
    <dl>
      <div><dt>Year</dt><dd>{year}</dd></div>
      {field && <div><dt>Field</dt><dd>{field}</dd></div>}
      {status && <div><dt>Status</dt><dd>{status}</dd></div>}
    </dl>
    {url && <a class="text-link" href={withBase(url)}>View project <span>→</span></a>}
  </div>
</article>

<style>
  .project { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, .8fr); align-items: center; gap: clamp(2.5rem, 7vw, 7rem); padding-block: clamp(4rem, 8vw, 7.5rem); border-top: 1px solid var(--border); }
  .project.reverse .project-image { order: 2; }
  .project-image { overflow: hidden; aspect-ratio: 16 / 10; border-radius: 1.6rem; background: var(--surface); }
  .project-image-link { position:relative; display:block; width:100%; height:100%; }
  .project-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .preview-hint { position:absolute; right:1rem; bottom:1rem; padding:.55rem .8rem; border:1px solid #ffffffa6; border-radius:999px; background:#f8f5eeed; color:var(--text); box-shadow:0 3px 15px #0002; font-size:.72rem; font-weight:700; letter-spacing:.01em; }
  .project-image-link:focus-visible { outline:3px solid var(--gold-dark); outline-offset:-3px; }
  .project:hover .project-image img { transform: scale(1.015); }
  .placeholder { height: 100%; display: grid; place-items: center; color: var(--gold-dark); background: radial-gradient(circle at 50% 20%, rgba(168,134,75,.15), transparent 40%), var(--surface); font-size: .74rem; letter-spacing: .18em; text-transform: uppercase; }
  h2 { margin: 0; font-family: var(--serif); font-size: clamp(2.2rem, 4vw, 4rem); font-weight: 400; letter-spacing: -.045em; line-height: 1.04; }
  .description { margin: 1.5rem 0 2rem; color: var(--text-secondary); font-size: 1.02rem; line-height: 1.75; }
  dl { margin: 0 0 2rem; border-top: 1px solid var(--border); }
  dl div { display: grid; grid-template-columns: 5rem 1fr; gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--border); font-size: .86rem; }
  dt { color: var(--text-secondary); }
  dd { margin: 0; }
  @media (max-width: 820px) {
    .project { grid-template-columns: 1fr; gap:1.75rem; padding-block:3.5rem; }
    .project.reverse .project-image { order: initial; }
  }
  @media (max-width: 480px) {
    .project-image { border-radius:1.1rem; }
    .preview-hint { right:.7rem; bottom:.7rem; font-size:.66rem; }
    h2 { font-size:clamp(2.2rem, 10vw, 3.2rem); }
    .description { margin:1.1rem 0 1.5rem; }
  }
</style>
