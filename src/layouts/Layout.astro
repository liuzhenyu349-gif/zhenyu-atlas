---
import "../styles/global.css";
import { Image } from "astro:assets";
import { navBarLinks, identity } from "../config";
import type { SEOInfo } from "../types/config";
import { withBase } from "../utils/url";
import markImage from "../assets/zhenyu-atlas-mark.png";

interface Props { seo: SEOInfo }
const { seo } = Astro.props;
const canonicalUrl = Astro.url.href;
const socialImageUrl = new URL(withBase(seo.image), Astro.site ?? Astro.url.origin).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: identity.name,
  url: new URL(withBase("/"), Astro.site ?? Astro.url.origin).href,
  image: socialImageUrl,
  email: `mailto:${identity.email}`,
  sameAs: ["https://github.com/liuzhenyu349-gif"],
  jobTitle: "Surveying Engineering Student",
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#F3EFE6" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta property="og:type" content={seo.type ?? "website"} />
    <meta property="og:site_name" content="Zhenyu Atlas" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Zhenyu Atlas preview" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="site-header">
      <div class="page-shell header-inner">
        <a class="brand" href={withBase("/")} aria-label="Zhenyu Atlas 首页">
          <span class="brand-mark"><Image src={markImage} alt="" width={92} height={92} format="webp" quality={82} /></span>
          <span>{identity.brand}</span>
        </a>
        <button class="menu-button" id="menu-button" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav id="site-nav" aria-label="主导航">
          <ul>
            {navBarLinks.map((link) => (
              <li><a href={withBase(link.url)} target={link.external ? "_blank" : undefined}>{link.title}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="page-shell footer-grid">
        <div>
          <p class="footer-brand">Zhenyu Atlas</p>
          <p class="muted">Mapping a brighter tomorrow.</p>
        </div>
        <div class="footer-meta">
          <p>Surveying · GIS · Python · AI</p>
          <p><a href="https://github.com/liuzhenyu349-gif">GitHub</a> · <a href={`mailto:${identity.email}`}>Email</a></p>
          <p class="muted">© 2026 Zhenyu Liu</p>
        </div>
      </div>
    </footer>

    <script>
      const button = document.getElementById("menu-button");
      const nav = document.getElementById("site-nav");
      button?.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!open));
        nav?.classList.toggle("is-open", !open);
      });
    </script>
  </body>
</html>

<style>
  .site-header { position: relative; z-index: 20; border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 92%, transparent); }
  .header-inner { min-height: 5.5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: .8rem; font-family: var(--serif); font-size: 1.16rem; font-weight: 700; letter-spacing: -.025em; }
  .brand-mark { width: 2.75rem; height: 2.75rem; overflow: hidden; border: 1px solid var(--border); border-radius: 50%; background: var(--surface-light); }
  .brand-mark :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.8); }
  nav ul { display: flex; align-items: center; gap: clamp(1.2rem, 3vw, 2.5rem); margin: 0; padding: 0; list-style: none; }
  nav a { color: var(--text-secondary); font-size: .9rem; font-weight: 600; transition: color .2s ease; }
  nav a:hover { color: var(--text); }
  .menu-button { display: none; border: 0; background: transparent; color: var(--text); font-weight: 700; }
  .site-footer { padding: 3.5rem 0; border-top: 1px solid var(--border); }
  .footer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .footer-grid p { margin: 0 0 .6rem; }
  .footer-brand { font-family: var(--serif); font-size: 1.5rem; }
  .footer-meta { text-align: right; font-size: .9rem; }
  @media (max-width: 700px) {
    .header-inner { min-height: 4.8rem; }
    .menu-button { display: block; }
    nav { position: absolute; top: calc(100% + 1px); right: 1.25rem; left: 1.25rem; visibility: hidden; opacity: 0; transform: translateY(-8px); border: 1px solid var(--border); border-radius: 1rem; background: var(--surface-light); transition: .2s ease; }
    nav.is-open { visibility: visible; opacity: 1; transform: translateY(0); }
    nav ul { align-items: stretch; flex-direction: column; gap: 0; padding: .6rem; }
    nav a { display: block; padding: .9rem 1rem; border-radius: .6rem; }
    nav a:hover { background: var(--bg-soft); }
    .footer-grid { grid-template-columns: 1fr; }
    .footer-meta { text-align: left; }
  }
</style>
