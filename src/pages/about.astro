---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { aboutPageContent, identity } from "../config";
import markImage from "../assets/zhenyu-atlas-mark.png";
---

<Layout seo={aboutPageContent.seo}>
  <section class="page-shell intro reveal">
    <div>
      <p class="eyebrow">// About Zhenyu</p>
      <h1 class="page-title">Maps are where I started. Code is where I’m going.</h1>
    </div>
    <p class="lead">I’m an undergraduate student majoring in Surveying Engineering, exploring how spatial thinking can meet Python, AI and software development.</p>
  </section>

  <section class="page-shell story section">
    <div class="mark-card card"><Image src={markImage} alt="Zhenyu Atlas ZA 标志" width={800} height={800} format="webp" quality={84} /></div>
    <div class="story-copy">
      <p class="eyebrow">Coordinates to code</p>
      <p class="story-large">I began with coordinates, fieldwork and maps. Now I’m learning to turn that way of seeing into useful digital tools.</p>
      <p class="lead">Zhenyu Atlas is not a finished résumé. It is a living record of practical experiments, honest progress and the work still ahead.</p>
    </div>
  </section>

  <section class="page-shell section focus">
    <div><p class="eyebrow">// Current focus</p><h2 class="section-title">One direction,<br />several disciplines.</h2></div>
    <div class="focus-list">
      {[
        ["01", "Surveying Engineering", "The technical foundation: measurement, coordinates and spatial accuracy."],
        ["02", "GIS", "Thinking in layers, relationships and the geography behind information."],
        ["03", "Python", "Turning repetitive work and raw data into clear, useful workflows."],
        ["04", "Artificial Intelligence", "Exploring responsible tools for learning, creation and problem-solving."],
      ].map(([number, title, copy]) => <article><span>{number}</span><h3>{title}</h3><p>{copy}</p></article>)}
    </div>
  </section>

  <section class="section connect">
    <div class="page-shell connect-inner">
      <p class="eyebrow">// Connect</p>
      <h2 class="section-title">Curious minds are always welcome.</h2>
      <p class="lead">I’m open to learning, exchanging ideas and connecting with people working in surveying, GIS, Python, AI or software development.</p>
      <div><a class="button-primary" href="https://github.com/liuzhenyu349-gif">GitHub ↗</a><a class="text-link" href={`mailto:${identity.email}`}>Email <span>→</span></a></div>
    </div>
  </section>
</Layout>

<style>
  .intro { display: grid; grid-template-columns: 1.15fr .85fr; align-items: end; gap: clamp(3rem, 8vw, 8rem); padding: clamp(5rem, 12vw, 10rem) 0; }
  .intro .lead { margin: 0; }
  .story { display: grid; grid-template-columns: minmax(18rem, .85fr) 1.15fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); }
  .mark-card { overflow: hidden; aspect-ratio: 1; }
  .mark-card :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .story-large { margin: 0 0 2rem; font-family: var(--serif); font-size: clamp(2rem, 4vw, 3.8rem); line-height: 1.12; letter-spacing: -.04em; }
  .focus { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 8rem); }
  .focus-list { border-top: 1px solid var(--border); }
  .focus-list article { display: grid; grid-template-columns: 3rem minmax(10rem, .8fr) 1.2fr; gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--border); }
  .focus-list span { color: var(--gold-dark); font-size: .75rem; }
  .focus-list h3, .focus-list p { margin: 0; }
  .focus-list h3 { font-family: var(--serif); font-size: 1.25rem; font-weight: 400; }
  .focus-list p { color: var(--text-secondary); line-height: 1.6; }
  .connect { background: var(--surface); }
  .connect-inner { max-width: 56rem; }
  .connect .lead { margin: 2rem 0; }
  .connect-inner > div { display: flex; align-items: center; gap: 1.5rem; }
  @media (max-width: 820px) { .intro, .story, .focus { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .focus-list article { grid-template-columns: 2.5rem 1fr; } .focus-list p { grid-column: 2; } .connect-inner > div { align-items: flex-start; flex-direction: column; } }
</style>
