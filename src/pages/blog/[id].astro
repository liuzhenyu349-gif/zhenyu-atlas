---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { identity } from "../../config";
import { withBase } from "../../utils/url";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"posts"> }
const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
---

<Layout seo={{ title: `${entry.data.title} · Zhenyu Atlas`, description: entry.data.description, image: entry.data.image.url, type: "article" }}>
  <article class="page-shell post">
    <header>
      <p class="eyebrow">// Journey</p>
      <h1 class="page-title">{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <div class="byline">
        <img src={withBase(identity.logo)} alt="Zhenyu Atlas" width="48" height="48" />
        <p><strong>{identity.name}</strong><br /><span>{entry.data.pubDate.toLocaleDateString()} · {remarkPluginFrontmatter.minutesRead}</span></p>
      </div>
    </header>
    <img class="cover" src={withBase(entry.data.image.url)} alt={entry.data.image.alt} width="1200" height="750" />
    <div class="prose"><Content /></div>
  </article>
</Layout>

<style>
  .post { padding: clamp(5rem, 10vw, 9rem) 0; }
  .post header { max-width: 58rem; }
  .post .lead { margin: 2rem 0; }
  .byline { display: flex; align-items: center; gap: .9rem; }
  .byline img { width: 3rem; height: 3rem; object-fit: cover; border-radius: 50%; border: 1px solid var(--border); }
  .byline p { margin: 0; line-height: 1.45; }
  .byline span { color: var(--text-secondary); font-size: .86rem; }
  .cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin: 4rem 0; border-radius: 1.5rem; }
  .prose { max-width: 46rem; margin-inline: auto; font-size: 1.08rem; line-height: 1.8; }
  .prose :global(h2), .prose :global(h3) { margin: 2.2em 0 .7em; font-family: var(--serif); font-weight: 400; }
  .prose :global(a) { text-decoration: underline; text-underline-offset: .2em; }
</style>
