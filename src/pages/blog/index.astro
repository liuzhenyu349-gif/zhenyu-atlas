---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { blogPageContent } from "../../config";
import { withBase } from "../../utils/url";

const posts = (await getCollection("posts")).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout seo={blogPageContent.seo}>
  <section class="page-shell intro reveal">
    <p class="eyebrow">// Journey archive</p>
    <h1 class="page-title">Learning, building and becoming.</h1>
    <p class="lead">{blogPageContent.subtitle}</p>
  </section>
  <section class="page-shell archive section">
    <div class="year">2026</div>
    <div class="entries">
      {posts.length === 0 ? (
        <article class="empty"><div><span>Journey</span><h2>Learning Python</h2></div><p>No invented entry yet. The first real note will appear when the work is ready to share.</p></article>
      ) : posts.map((post) => (
        <a class="entry" href={withBase(`/blog/${post.id}`)}>
          <time>{post.data.pubDate.toLocaleDateString()}</time><div><span>Journey</span><h2>{post.data.title}</h2><p>{post.data.description}</p></div><b>→</b>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .intro { padding: clamp(5rem, 12vw, 10rem) 0 clamp(3rem, 6vw, 6rem); }
  .intro .lead { margin: 2rem 0 0; }
  .archive { display: grid; grid-template-columns: .3fr 1.7fr; gap: clamp(2rem, 8vw, 8rem); padding-top: 0; }
  .year { color: var(--gold-dark); font-family: var(--serif); font-size: clamp(2rem, 4vw, 3.4rem); }
  .entries { border-top: 1px solid var(--border); }
  .entry, .empty { display: grid; grid-template-columns: 9rem 1fr auto; gap: 2rem; padding: 2rem 0; border-bottom: 1px solid var(--border); }
  .entry time, .entry span, .empty span { color: var(--text-secondary); font-size: .75rem; text-transform: uppercase; letter-spacing: .12em; }
  .entry h2, .empty h2 { margin: .35rem 0 .7rem; font-family: var(--serif); font-size: clamp(1.8rem, 3vw, 2.7rem); font-weight: 400; }
  .entry p, .empty p { margin: 0; color: var(--text-secondary); line-height: 1.65; }
  @media (max-width: 700px) { .archive { grid-template-columns: 1fr; } .entry, .empty { grid-template-columns: 1fr auto; } .entry time { grid-column: 1 / -1; } .empty p { grid-column: 1 / -1; } }
</style>
