---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { homePageContent, identity, projectsPageContent } from "../config";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { withBase } from "../utils/url";
import heroImage from "../assets/zhenyu-atlas-hero.png";

const posts = (await getCollection("posts")).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
---

<Layout seo={homePageContent.seo}>
  <section class="hero page-shell reveal">
    <div class="hero-copy">
      <p class="eyebrow">34°N · 113°E / ZHENGZHOU</p>
      <p class="brand-name">{identity.brand}</p>
      <h1 class="display">Mapping a brighter tomorrow.</h1>
      <p class="role">{homePageContent.role}</p>
      <p class="lead">{homePageContent.description}</p>
      <a class="button-primary" href={withBase("/projects")}>Explore my work <span>→</span></a>
    </div>
    <figure class="hero-art">
      <Image src={heroImage} alt="Golden Atlas figure with cartographic compass and globe" width={900} height={900} format="webp" quality={82} loading="eager" fetchpriority="high" />
      <figcaption>Atlas / Direction / Discovery</figcaption>
    </figure>
  </section>

  <section class="section page-shell">
    <div class="section-head">
      <div><p class="eyebrow">// Selected work</p><h2 class="section-title">Featured work</h2></div>
      <a class="text-link" href={withBase("/projects")}>All work <span>→</span></a>
    </div>
    <div class="featured-list">
      {projectsPageContent.projects.map((project, index) => <ProjectCard {...project} index={index} />)}
    </div>
  </section>

  <section class="section page-shell about-preview">
    <div><p class="eyebrow">// About</p><h2 class="section-title">Maps are where I started.<br />Code is where I’m going.</h2></div>
    <div>
      <p class="lead">I’m Zhenyu Liu, a Surveying Engineering student exploring GIS, Python, AI and software development through practical projects.</p>
      <a class="text-link" href={withBase("/about")}>Read my story <span>→</span></a>
    </div>
  </section>

  <section class="section page-shell">
    <div class="section-head">
      <div><p class="eyebrow">// Journey</p><h2 class="section-title">Field notes</h2></div>
      <a class="text-link" href={withBase("/blog")}>Open archive <span>→</span></a>
    </div>
    {posts.length === 0 ? (
      <div class="journey-empty card">
        <span>2026</span><div><p class="eyebrow">Journey</p><h3>Learning in public</h3><p class="muted">The first real learning note will appear here when it is ready. No invented milestones.</p></div>
      </div>
    ) : (
      <div class="journey-list">{posts.map((post) => <a href={withBase(`/blog/${post.id}`)}><time>{post.data.pubDate.toLocaleDateString()}</time><strong>{post.data.title}</strong><span>→</span></a>)}</div>
    )}
  </section>

  <section class="section contact-band">
    <div class="page-shell contact-inner">
      <div><p class="eyebrow">// Contact</p><h2 class="section-title">Let’s map what comes next.</h2></div>
      <div class="contact-links"><a href="https://github.com/liuzhenyu349-gif">GitHub ↗</a><a href={`mailto:${identity.email}`}>Email ↗</a></div>
    </div>
  </section>
</Layout>

<style>
  .hero { min-height: calc(100svh - 5.5rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(24rem, .82fr); align-items: center; gap: clamp(3rem, 6vw, 6rem); padding-block: clamp(4rem, 8vw, 8rem); }
  .brand-name { margin: 0 0 1.2rem; font-family: var(--serif); font-size: clamp(1.4rem, 2vw, 2rem); }
  .role { margin: 2rem 0 .7rem; color: var(--gold-dark); font-size: .78rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .hero .lead { margin: 0 0 2rem; }
  .hero-art { position: relative; margin: 0; overflow: hidden; border-radius: 50% 50% 1.75rem 1.75rem; background: var(--black); }
  .hero-art::after { content: ""; position: absolute; inset: auto 0 0; height: 22%; background: linear-gradient(transparent, rgba(10,8,5,.82)); pointer-events: none; }
  .hero-art :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .hero-art figcaption { position: absolute; z-index: 1; right: 1.5rem; bottom: 1.2rem; left: 1.5rem; color: #f5e7c9; font-size: .66rem; letter-spacing: .18em; text-transform: uppercase; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 3rem; }
  .featured-list :global(.project:first-child) { border-top: 0; }
  .about-preview { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(3rem, 8vw, 8rem); align-items: end; }
  .about-preview .lead { margin: 0 0 2rem; }
  .journey-empty { display: grid; grid-template-columns: 8rem 1fr; gap: 2rem; margin-top: 3rem; padding: clamp(2rem, 5vw, 4rem); }
  .journey-empty > span { color: var(--gold-dark); font-family: var(--serif); font-size: 2rem; }
  .journey-empty h3 { margin: 0 0 .8rem; font-family: var(--serif); font-size: 2rem; font-weight: 400; }
  .journey-list a { display: grid; grid-template-columns: 10rem 1fr auto; gap: 1rem; padding: 1.4rem 0; border-top: 1px solid var(--border); }
  .contact-band { background: var(--black); color: var(--surface-light); }
  .contact-band .eyebrow { color: var(--gold-light); }
  .contact-inner { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 3rem; }
  .contact-links { display: flex; gap: 1.5rem; }
  .contact-links a { border-bottom: 1px solid rgba(255,255,255,.4); padding-bottom: .25rem; }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; } .hero-art { max-width: 44rem; } .about-preview { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .hero { min-height: auto; padding-top: 4rem; padding-bottom: 2.5rem; } .hero-copy { display: contents; } .hero-copy .eyebrow, .brand-name, .display, .role, .hero-copy .lead, .hero-copy .button-primary { grid-column: 1; } .hero-art { margin-top: 1rem; } .hero + .section { padding-top: 3.5rem; } .section-head { align-items: flex-start; flex-direction: column; } .journey-empty { grid-template-columns: 1fr; } .contact-inner { grid-template-columns: 1fr; align-items: start; } .contact-links { flex-direction: column; align-items: flex-start; } }
</style>
