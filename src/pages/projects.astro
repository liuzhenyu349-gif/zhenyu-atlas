---
import Layout from "../layouts/Layout.astro";
import { projectsPageContent } from "../config";
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout seo={projectsPageContent.seo}>
  <section class="page-shell page-intro reveal">
    <p class="eyebrow">// Selected work</p>
    <h1 class="page-title">Built to explore space, data and motion.</h1>
    <p class="lead">{projectsPageContent.subtitle}</p>
  </section>
  <section class="page-shell projects">
    {projectsPageContent.projects.map((project, index) => <ProjectCard {...project} index={index} />)}
  </section>
</Layout>

<style>
  .page-intro { padding: clamp(5rem, 12vw, 10rem) 0 clamp(4rem, 8vw, 7rem); }
  .page-intro .lead { margin: 2rem 0 0; }
  .projects { padding-bottom: var(--section-space); }
</style>
